# Hermes 配置文件忽略规则
# 只同步 config.yaml / SOUL.md / memories/，其余均排除

# 敏感文件
auth.json
auth.lock
.env
*.token
*.key
.env.*

# 锁文件（每设备独立）
*.lock
*.pid

# 数据库（每个设备独立）
*.db
*.db-wal
*.db-shm

# 缓存和日志
cache/
logs/
checkpoints/
.hermit/
request_dump*

# 临时文件
*.log
*.tmp
*~
*.bak
*.bak.*
*.save

# 系统文件
.DS_Store
Thumbs.db
.git/

# node_modules（避免重复安装）
node_modules/

# 运行时状态（每台电脑独立）
.state-snapshots/
processes.json
gateway_state.json
gateway/
lsp/
pairing/
pastes/
screen_capture_dataurl.txt
.mcp-discovery.lock
.hermes-update-in-progress
._curator_backups
.update_check
.clean_shutdown
.hermes_history
memories/*.lock
